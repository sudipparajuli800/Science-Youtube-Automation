# API Keys
GEMINI_API_KEY="api key"
GROQ_API_KEY="api key"

# Hosted video generation: trial/prepaid credits, NOT unlimited free inference.
# Add KIE_API_KEY or FAL_KEY as GitHub Actions repository secrets, not in git.
KIE_API_KEY=
FAL_KEY=
VIDEO_GEN_PROVIDER=auto
VIDEO_GEN_MAX_CLIPS=1
VIDEO_GEN_DAILY_LIMIT=2
VIDEO_GEN_TIMEOUT=600
# Limits count submitted tasks, including failed/ambiguous attempts. No auto top-ups.
# Optional reviewed clips generated interactively on a cloud GPU:
VISUAL_BANK_MANIFEST=automation/storage/visual_bank/manifest.json
VISUAL_BANK_URL=

# Pexels & Pixabay (both free, no credit card, ~2 minutes to sign up) — real stock
# photos AND video b-roll that actually match the script's subject, used before the
# DDG-scraping fallback (which gets rate-limited under normal automated use) and
# before Pollinations.ai AI image generation. Optional: everything still works
# without these, just with less reliable/relevant visuals.
#   Pexels:  https://www.pexels.com/api/
#   Pixabay: https://pixabay.com/api/docs/
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# Visual verification rotates GEMINI_API_KEY / KEY2 / KEY3, then GROQ_API_KEY / KEY2 / KEY3.
# Reuses the existing Groq secrets. Requires vision access and available provider quota.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# When all vision providers fail, videos use labeled local script-summary cards.
# This degraded mode does not accept unverified footage.
GEMINI_MODEL=gemini-flash-latest
# Disabling verification accepts unverified footage; keep it enabled for production.
# DISABLE_VISUAL_RELEVANCE_CHECK=true

# Telegram (Optional - for Telegram Fetcher)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# YouTube (Handled via client_secrets.json and token.pickle)
# You will need to run the script locally once to generate token.pickle

# Optional CPU fallback for stock matching after remote vision quota is exhausted.
# GitHub workflow installs CPU PyTorch + Transformers and enables this automatically.
LOCAL_VISUAL_RELEVANCE=true
