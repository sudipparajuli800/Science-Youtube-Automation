# Environment variables
.env
.env.local
.env.*

# Secrets and credentials
client_secret.json
client_secrets.json
token.pickle
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Media and Storage
storage/*
!storage/*.json
media/*.mp4
media/*.mp3
media/*.jpg
media/*.png

# Automation storage — exclude all generated/temp files, keep only JSON state
automation/storage/temp_images/
automation/storage/temp_videos/
automation/storage/thumbnails/
automation/storage/*.mp4
automation/storage/*.mp3
automation/storage/*.srt
automation/storage/*.jpg
automation/storage/*.png

# Block all audio/video by default but allow music folder
*.mp3
*.mp4
!music/*.mp3
!music/*.wav
!automation/musics/**/*.mp3
!automation/musics/**/*.wav
!automation/music/**/*.mp3
!automation/media/assets/*.mp4
# SFX are tiny, deterministically-generated (automation/media/sfx/generate_sfx.py) files
# that MUST ship with the repo — without this exemption the blanket "*.mp3" rule above
# silently excluded them, so a fresh CI checkout had NO sfx files at all and every
# whoosh/dong/sweep/riser/impact/shimmer SFX cue in every rendered video was a no-op
# (all the `if os.path.exists(sfx_path)` guards throughout the renderer just skipped).
!automation/media/sfx/*.mp3
!automation/media/assets/*.png
*.log

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Generated media caches (task ledger remains in state JSON)
automation/storage/generated_clips/
automation/storage/mpl-cache/
automation/media/visual_bank/*.mp4
automation/storage/visual_bank/

# Remotion dependencies, browser, bundles and rendered scene cache
motion/node_modules/
motion/.bundle/
motion/.bundle-stamp
motion/.renderer-ready
.remotion/
motion/.remotion/
automation/storage/motion_cache/
